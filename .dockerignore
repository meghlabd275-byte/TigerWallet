# Images that build from the repository root need their sources allowlisted
# here, because the default is to exclude everything.
*
# The Go backends build from the root so they can see the sibling chainsdk
# module.
!go/chainsdk
!go/wallet_api
!master_wallet/backend
!deployments/docker/Dockerfile.go-backend
# The AI prediction service builds from the root for the same reason.
!ai_layer/python

# Build output and toolchain caches.
**/target
**/dist
**/build
**/node_modules
**/.git
**/*.log
**/coverage
