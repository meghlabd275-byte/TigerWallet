{
  "manifest_version": 2,
  "name": "TigerWallet Admin",
  "version": "1.0.0",
  "description": "TigerWallet Admin Panel - Complete administration for platform management",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "webNavigation",
    "notifications",
    "contextMenus",
    "cookies",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_title": "TigerWallet Admin"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    "icons/*",
    "styles/*"
  ],
  "options_page": "options.html",
  "devtools_page": "devtools.html"
}
