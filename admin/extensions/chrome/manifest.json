{
  "manifest_version": 3,
  "name": "TigerWallet Admin",
  "version": "1.0.0",
  "description": "TigerWallet Admin Browser Extension - Complete Dark/Light Theme Support",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "notifications",
    "contextMenus",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
