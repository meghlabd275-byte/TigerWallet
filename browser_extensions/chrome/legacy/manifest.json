{
  "manifest_version": 3,
  "name": "TigerWallet - Web3 Wallet",
  "version": "1.0.0",
  "description": "Secure multi-chain cryptocurrency wallet with DeFi integration",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "TigerWallet"
  },
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/inject.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "webNavigation",
    "webRequest",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-wallet": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Toggle TigerWallet popup"
    },
    "quick-swap": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Quick swap from anywhere"
    }
  }
}
