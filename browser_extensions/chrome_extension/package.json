{
  "name": "tiger-wallet-extension",
  "version": "2.0.0",
  "description": "TigerWallet - Enterprise Multi-chain Web3 Wallet Extension",
  "main": "dist/background.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "ethers": "^6.13.0",
    "@solana/web3.js": "^1.95.0",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@mysten/sui.js": "^1.0.0",
    "aptos": "^1.20.0",
    "bn.js": "^5.2.1",
    "bip39": "^3.1.0",
    "@scure/bip32": "^1.3.0",
    "@scure/bip39": "^1.2.0",
    "lucide-react": "^0.450.0",
    "zustand": "^4.5.0",
    "framer-motion": "^10.17.4",
    "wagmi": "^2.0.0",
    "viem": "^2.0.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.251",
    "@types/node": "^20.15.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.2.0",
    "vitest": "^2.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "manifest_version": 3,
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "webRequest"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ]
}