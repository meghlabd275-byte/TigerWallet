{
  "manifest_version": 2,
  "name": "TigerWallet Super Admin",
  "version": "1.0.0",
  "description": "Super Admin extension for TigerWallet management",
  "permissions": [
    "activeTab",
    "storage",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.tigerwallet.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
