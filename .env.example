# TigerWallet environment template.
#
# Copy to .env and fill in every value marked REQUIRED. Compose is
# fail-closed: a missing REQUIRED variable aborts `docker compose up`
# with the named error rather than starting a service with a blank
# secret. Generate strong values, e.g.:
#
#   openssl rand -hex 32
#
# Never commit a filled-in .env (it is git-ignored).

# ======================================================================
# Chain endpoints
# ======================================================================
#AA_RPC_URL=
#ARBITRUM_RPC_URL=
#AVALANCHE_RPC_URL=
#BSC_RPC_URL=
# https://ethereum.publicnode.com
#ETHEREUM_RPC_URL=https://ethereum.publicnode.com
#ETH_RPC_URL=
#OPTIMISM_RPC_URL=
#POLYGON_RPC_URL=
#PP_RPC_URL=

# ======================================================================
# Integration and feature toggles
# ======================================================================
#AA_ACCOUNT_FACTORY=
#AA_BENEFICIARY=
#AA_ENTRY_POINT=
#AA_PAYMASTER_ADDRESS=
#ADMIN_USER_ID=
#ALLOWED_ORIGINS=
# 180
#BRIDGE_ACROSS_DURATION_SEC=180
# 3
#BRIDGE_ACROSS_FEE_BPS=3
# 0
#BRIDGE_ACROSS_FEE_FIXED=0
# 0
#BRIDGE_FEE_BPS=0
# 300
#BRIDGE_STARGATE_DURATION_SEC=300
# 5
#BRIDGE_STARGATE_FEE_BPS=5
# 0
#BRIDGE_STARGATE_FEE_FIXED=0
# https://api.coingecko.com/api/v3
#COINGECKO_BASE=https://api.coingecko.com/api/v3
# https://api.coingecko.com/api/v3
#COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# 12
#CONFIRMATION_BLOCKS=12
#EMAIL_WEBHOOK_URL=
# noreply@tigerwallet.com
#FROM_EMAIL=noreply@tigerwallet.com
#FUND_CONTRACT_ADDRESS=
#GOVERNANCE_MULTISIG=
#GOVERNANCE_SIGNERS=
# 3
#GOVERNANCE_THRESHOLD=3
# admin
#GRAFANA_USER=admin
# 100000000000000000000000
#INITIAL_REWARD_POOL=100000000000000000000000
#LISTING_SUPERADMIN_EMAIL=
#MASTER_WALLET_BUNDLER_URL=
#MASTER_WALLET_PAYMASTER_URL=
# 100000000000000000000000
#MAX_REWARD=100000000000000000000000
# 100000000000000000
#MIN_REWARD=100000000000000000
#MPC_ALLOWED_ORIGINS=
#PP_LAUNCHPAD_CONTRACT_ADDRESS=
#PUSH_WEBHOOK_URL=
#SMS_WEBHOOK_URL=
# rocketpool
#STAKING_APR_PROVIDER_RETH=rocketpool
# lido
#STAKING_APR_PROVIDER_STETH=lido
# staging
#TRANSAK_ENV=staging
# TigerWallet
#TWO_FACTOR_ISSUER_NAME=TigerWallet
# http://wallet-api:8443
#WALLET_API_URL=http://wallet-api:8443
#WC_PROJECT_ID=

# ======================================================================
# Notifications
# ======================================================================
#SMTP_PASS=
# 587
#SMTP_PORT=587
#SMTP_SERVER=
#SMTP_USER=
#TWILIO_ACCOUNT_SID=
#TWILIO_FROM_NUMBER=

# ======================================================================
# PostgreSQL
# ======================================================================
# POSTGRES_PASSWORD must be set - a committed default is a known credential
POSTGRES_PASSWORD=
# tigerwallet_admin
#POSTGRES_DB=tigerwallet_admin
# tigerwallet
#POSTGRES_USER=tigerwallet

# ======================================================================
# Secrets and keys
# ======================================================================
# ADMIN_JWT_SECRET must be set to a strong value
ADMIN_JWT_SECRET=
# GRAFANA_PASSWORD must be set
GRAFANA_PASSWORD=
# JWT_SECRET must be set to a strong value
JWT_SECRET=
# KYC_API_TOKEN must be set - the P2P and card gates fail closed without it
KYC_API_TOKEN=
# KYC_REVIEWER_TOKEN must be set
KYC_REVIEWER_TOKEN=
# MASTER_WALLET_JWT_SECRET must be set
MASTER_WALLET_JWT_SECRET=
# MPC_JWT_SECRET must be set
MPC_JWT_SECRET=
# PASSKEY_ENCRYPTION_KEY must be set to at least 32 characters
PASSKEY_ENCRYPTION_KEY=
# PROTECTION_FUND_ADMIN_TOKEN must be set to a strong value
PROTECTION_FUND_ADMIN_TOKEN=
# SUPER_ADMIN_SECRET must be set - permission-service gates its control plane with it
SUPER_ADMIN_SECRET=
# WHITE_LABEL_JWT_SECRET must be set to a strong value
WHITE_LABEL_JWT_SECRET=
#AA_PAYMASTER_SIGNER_KEY=
#COINGECKO_API_KEY=
#EMAIL_WEBHOOK_TOKEN=
#ETHERSCAN_API_KEY=
#FUND_TOKEN_ADDRESS=
#GATE_ED25519_PUBLIC_KEY=
#MASTER_WALLET_TREASURY_KEY_HEX=
#MOONPAY_API_KEY=
# https://tigerwallet.com
#PASSKEY_ORIGIN=https://tigerwallet.com
# tigerwallet.com
#PASSKEY_RPID=tigerwallet.com
#PAYMENT_WEBHOOK_SECRET=
#PP_LAUNCHPAD_PRIVATE_KEY=
#PP_SERVICE_TOKEN=
#PUSH_WEBHOOK_TOKEN=
#SMS_WEBHOOK_TOKEN=
#TRANSAK_API_KEY=
#TSC_VALIDATOR_KEY=
#TWILIO_AUTH_TOKEN=
#WALLET_API_ADMIN_TOKEN=
#WC_SIGNER_PRIVATE_KEY=

# ======================================================================
# TigerSmartChain
# ======================================================================
# TSC_GENESIS_SEED must be set - it determines the genesis block every node must agree on
TSC_GENESIS_SEED=
# true
#TSC_MINE=true
# 1
#TSC_VALIDATORS=1

# ======================================================================
# White-label products
# ======================================================================
# WL_ADMIN_JWT_SECRET must be set - a committed default would let anyone mint admin tokens
WL_ADMIN_JWT_SECRET=
# WL_BOTS_JWT_SECRET must be set - a committed default would let anyone mint tenant tokens
WL_BOTS_JWT_SECRET=
# WL_CARD_ENC_KEY must be set - this key encrypts stored card data
WL_CARD_ENC_KEY=
# WL_CARD_JWT_SECRET must be set - a committed default would let anyone mint tenant tokens
WL_CARD_JWT_SECRET=
# WL_JWT_SECRET must be set - a committed default would let anyone mint tenant tokens
WL_JWT_SECRET=
# WL_LIQ_JWT_SECRET must be set - a committed default would let anyone mint tenant tokens
WL_LIQ_JWT_SECRET=
# WL_MW_JWT_SECRET must be set - a committed default would let anyone mint tenant tokens
WL_MW_JWT_SECRET=
# WL_PP_JWT_SECRET must be set - a committed default would let anyone mint tenant tokens
WL_PP_JWT_SECRET=
#WL_GATE_TOKEN=
