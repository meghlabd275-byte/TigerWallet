{
  "server": {
    "host": "0.0.0.0",
    "port": 9091,
    "num_threads": 8,
    "request_timeout": 30,
    "max_body_size": 10485760,
    "enable_tls": true,
    "cert_file": "/etc/tigeradmin/certs/server.crt",
    "key_file": "/etc/tigeradmin/certs/server.key"
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "tigerwallet_admin",
    "user": "tigeradmin",
    "password": "${DB_PASSWORD}",
    "min_connections": 10,
    "max_connections": 100,
    "connection_timeout": 30,
    "idle_timeout": 300,
    "max_lifetime": 3600
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "${REDIS_PASSWORD}",
    "db": 0,
    "min_connections": 5,
    "max_connections": 50,
    "connection_timeout": 5,
    "read_timeout": 5,
    "write_timeout": 5
  },
  "security": {
    "jwt_secret": "${JWT_SECRET}",
    "jwt_ttl": 86400,
    "jwt_issuer": "tigerwallet-admin",
    "bcrypt_rounds": 12,
    "password_min_length": 12,
    "password_require_uppercase": true,
    "password_require_lowercase": true,
    "password_require_numbers": true,
    "password_require_special": true,
    "max_login_attempts": 5,
    "lockout_duration": 900,
    "session_ttl": 86400,
    "max_sessions_per_user": 5,
    "require_2fa_for_admins": true,
    "require_2fa_for_support": false
  },
  "rate_limiting": {
    "enabled": true,
    "global": {
      "requests_per_minute": 1000,
      "requests_per_hour": 10000
    },
    "auth": {
      "login_per_minute": 5,
      "login_per_hour": 20
    },
    "api": {
      "requests_per_minute": 100,
      "requests_per_hour": 1000
    }
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": "stdout",
    "file": "/var/log/tigeradmin/app.log",
    "max_file_size": 104857600,
    "max_files": 10,
    "enable_console": true
  },
  "cors": {
    "enabled": true,
    "allowed_origins": ["*"],
    "allowed_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
    "allowed_headers": ["Content-Type", "Authorization", "X-Requested-With", "X-API-Key"],
    "expose_headers": ["X-Total-Count", "X-Page-Count"],
    "max_age": 86400
  },
  "features": {
    "enable_registration": false,
    "enable_2fa": true,
    "enable_api_keys": true,
    "enable_webhooks": true,
    "enable_audit_logs": true,
    "enable_ip_whitelist": true,
    "enable_rate_limiting": true
  },
  "admin": {
    "default_super_admin_email": "admin@tigerwallet.com",
    "default_super_admin_username": "superadmin",
    "default_password_change_required": true,
    "password_expiry_days": 90,
    "session_expiry_hours": 24
  },
  "notifications": {
    "email": {
      "enabled": true,
      "smtp_host": "${SMTP_HOST}",
      "smtp_port": 587,
      "smtp_user": "${SMTP_USER}",
      "smtp_password": "${SMTP_PASSWORD}",
      "from_email": "noreply@tigerwallet.com",
      "from_name": "TigerWallet Admin"
    },
    "slack": {
      "enabled": false,
      "webhook_url": "${SLACK_WEBHOOK_URL}"
    }
  },
  "monitoring": {
    "enable_metrics": true,
    "metrics_port": 9092,
    "enable_pprof": false,
    "pprof_port": 9093
  }
}
