{
  "manifest_version": 3,
  "name": "UserWallet Extension",
  "version": "1.0.0",
  "description": "TigerWallet UserWallet — connect to the canonical wallet-api backend.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8443/*"
  ],
  "action": {
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
