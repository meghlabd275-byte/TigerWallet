{
  "manifest_version": 3,
  "name": "UserWallet Extension",
  "version": "1.1.0",
  "description": "TigerWallet UserWallet — EIP-1193 provider injection + canonical wallet-api backend.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8443/*",
    "https://api.tigerwallet.com/*",
    "https://*.tigerwallet.com/*"
  ],
  "action": {
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/contentScript.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/inpage.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
