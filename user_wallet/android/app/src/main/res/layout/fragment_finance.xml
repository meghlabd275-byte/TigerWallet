<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wallet &amp; Finance"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/finAccountsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deposit addresses (tap to copy)"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/finDepositsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Spinner
            android:id="@+id/finCurrencySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/finToInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Recipient email (internal transfer)" />
        <EditText
            android:id="@+id/finAmountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Amount"
            android:inputType="numberDecimal" />
        <Button
            android:id="@+id/finTransferBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transfer (KYC-gated)" />

        <EditText
            android:id="@+id/finWAddressInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Withdrawal destination address" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/finWithdrawBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Withdraw" />
            <Button
                android:id="@+id/finConvertBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Convert → USDC" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Convert rates"
            android:layout_marginTop="12dp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/finRatesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P2P escrow market"
            android:layout_marginTop="12dp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/finEscrowList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ledger history"
            android:layout_marginTop="12dp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/finHistoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/finStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
