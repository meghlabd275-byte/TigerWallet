<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fiat On/Off Ramp"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rampProvidersText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/rampProviderIdInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Provider ID"
        android:inputType="text" />

    <EditText
        android:id="@+id/rampAmountInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Amount"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/rampFiatInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fiat currency (USD)"
        android:inputType="text" />

    <EditText
        android:id="@+id/rampCryptoInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Crypto (ETH)"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rampBuyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Buy Quote" />

        <Button
            android:id="@+id/rampSellButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Sell Quote" />
    </LinearLayout>

    <TextView
        android:id="@+id/rampQuoteText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textSize="12sp" />

</LinearLayout>
