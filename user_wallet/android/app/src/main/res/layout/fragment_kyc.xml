<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Identity Verification (KYC)"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="KYC required only for P2P trading."
        android:textSize="13sp"
        android:alpha="0.7" />

    <ProgressBar
        android:id="@+id/kycProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/kycStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/kycVerifiedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="16dp"
        android:background="@color/kyc_verified"
        android:text="KYC Verified — P2P trading enabled"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Submission form (shown when not verified) -->
    <EditText
        android:id="@+id/kycFullNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Full legal name"
        android:inputType="textPersonName"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/kycDocumentTypeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/kycDocumentNumberInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Document number"
        android:inputType="text"
        android:visibility="gone" />

    <Button
        android:id="@+id/startKycButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Start KYC"
        android:visibility="gone" />

    <Button
        android:id="@+id/refreshKycButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Refresh status"
        android:visibility="gone" />

    <EditText
        android:id="@+id/kycSessionInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="KYC session id (lookup)"
        android:layout_marginTop="12dp"
        android:inputType="text" />

    <Button
        android:id="@+id/kycSessionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Look up session" />

</LinearLayout>
