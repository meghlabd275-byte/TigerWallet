<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trading (Perpetual &amp; Margin)"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tradingPerpText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tradingMarginText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/tradingPairInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Pair (ETH/USDC)"
        android:inputType="text" />

    <EditText
        android:id="@+id/tradingSideInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Side (long/short)"
        android:inputType="text" />

    <EditText
        android:id="@+id/tradingSizeInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Size"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/tradingLeverageInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Leverage"
        android:inputType="number" />

    <Button
        android:id="@+id/tradingOpenPerpButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open Perpetual" />

    <Button
        android:id="@+id/tradingOpenMarginButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open Margin" />

    <EditText
        android:id="@+id/tradingPositionIdInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Position ID"
        android:inputType="text" />

    <Button
        android:id="@+id/tradingClosePerpButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Close Perpetual" />

    <Button
        android:id="@+id/tradingCloseMarginButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Close Margin" />

    <TextView
        android:id="@+id/tradingStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textSize="12sp" />
</LinearLayout>
