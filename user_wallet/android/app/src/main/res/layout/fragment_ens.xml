<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENS"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Resolve Name → Address"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/ensNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="name.eth"
        android:inputType="text" />

    <Button
        android:id="@+id/ensResolveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resolve" />

    <TextView
        android:id="@+id/ensResolveResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Reverse Lookup Address → Name"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/ensAddressInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="0x…"
        android:inputType="text" />

    <Button
        android:id="@+id/ensLookupButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lookup" />

    <TextView
        android:id="@+id/ensLookupResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textSize="12sp" />

</LinearLayout>
