{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "devtools": true
  },
  "package": {
    "productName": "TigerWallet",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": true
      },
      "dialog": {
        "all": true
      },
      "notification": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": ["$APP/**", "$RESOURCE/**", "$DOWNLOAD/**"]
      },
      "path": {
        "all": true
      },
      "os": {
        "all": true
      },
      "process": {
        "all": true
      },
      "clipboard": {
        "all": true
      },
      "crypto": {
        "all": true
      },
      "http": {
        "all": true,
        "scope": ["https://**", "http://**"]
      },
      "storage": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Finance",
      "copyright": "TigerWallet 2026",
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.tigerwallet.desktop",
      "longDescription": "TigerWallet Desktop - Enterprise-grade multi-chain cryptocurrency wallet with hardware wallet support, MEV protection, and advanced security features",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null,
        "minimumSystemVersion": "10.15"
      },
      "resources": [],
      "shortDescription": "Multi-chain cryptocurrency wallet",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "webviewInstallMode": {
          "type": "embedBootstrapper"
        }
      },
      "linux": {
        "appimage": {
          "bundleMediaFramework": true
        }
      }
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://* http://*"
    },
    "updater": {
      "active": true,
      "pubkey": "",
      "endpoints": []
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 700,
        "resizable": true,
        "title": "TigerWallet - Secure Multi-Chain Wallet",
        "width": 1100,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "focus": true,
        "visible": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "resizable": true,
        "fullscreenable": true,
        "alwaysOnTop": false
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  }
}
