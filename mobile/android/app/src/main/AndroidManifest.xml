<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tigerwallet.app">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>

    <application
        android:name=".TigerWalletApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        
        <activity android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- DApp Browser Service -->
        <service android:name=".services.DAppBrowserService"
            android:exported="false"/>

        <!-- Bridge Service -->
        <service android:name=".services.BridgeService"
            android:exported="false"/>

        <!-- Gift Card Service -->
        <service android:name=".services.GiftCardService"
            android:exported="false"/>

        <!-- Lending Service -->
        <service android:name=".services.LendingService"
            android:exported="false"/>

        <!-- Hardware Wallet Service -->
        <service android:name=".services.HardwareWalletService"
            android:exported="false"/>

        <!-- MPC Wallet Service -->
        <service android:name=".services.MPCWalletService"
            android:exported="false"/>

        <!-- Social Recovery Service -->
        <service android:name=".services.SocialRecoveryService"
            android:exported="false"/>

        <!-- Account Abstraction Service -->
        <service android:name=".services.AccountAbstractionService"
            android:exported="false"/>

    </application>

</manifest>
